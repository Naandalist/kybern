---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(Settings)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "description": "User settings persisted at `<data_dir>/settings.json`.",
  "type": "object",
  "properties": {
    "default_provider": {
      "$ref": "#/$defs/ProviderKind",
      "default": "claude-code"
    },
    "default_permission_mode": {
      "$ref": "#/$defs/PermissionMode",
      "default": "supervised"
    },
    "worktrees_default": {
      "description": "Global default for new threads; projects can override.",
      "type": "boolean",
      "default": false
    },
    "automatic_worktree_cleanup": {
      "description": "Remove clean, merged, inactive managed worktrees when their thread is archived.",
      "type": "boolean",
      "default": false
    },
    "generate_titles": {
      "description": "Generate thread titles with a model after the first turn.",
      "type": "boolean",
      "default": true
    },
    "title_provider": {
      "description": "Provider used for titles; falls back to the thread's own provider.",
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "providers": {
      "type": "object",
      "properties": {
        "antigravity": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "claude-code": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "codex": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "cursor": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "omp": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "opencode": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "pi": {
          "$ref": "#/$defs/ProviderSettings"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "notifications": {
      "description": "Show OS notifications when a turn ends or needs approval.",
      "type": "boolean",
      "default": true
    },
    "auto_update_harnesses": {
      "description": "Check installed harnesses daily and update them when idle. Opt-in per environment.",
      "type": "boolean",
      "default": false
    },
    "auto_update_daemon": {
      "description": "Check the release feed daily and replace this daemon when idle. Opt-in\nper environment; ignored for a daemon the desktop app manages.",
      "type": "boolean",
      "default": false
    },
    "update_track": {
      "description": "Which releases the desktop app and a self-updating daemon move to.",
      "$ref": "#/$defs/UpdateTrack",
      "default": "stable"
    },
    "background": {
      "description": "How the daemon trims CPU and memory while nothing needs it.",
      "$ref": "#/$defs/BackgroundSettings",
      "default": {
        "session_idle_minutes": 10,
        "max_idle_sessions": 4,
        "terminal_idle_minutes": 60,
        "daemon_idle_exit_minutes": 0,
        "save_power_on_battery": false
      }
    },
    "access": {
      "description": "Which networks other devices can reach this daemon on.",
      "$ref": "#/$defs/AccessSettings",
      "default": {
        "tailscale": false
      }
    },
    "computer_use": {
      "description": "Desktop control through CuaDriver for non-Codex harnesses.",
      "$ref": "#/$defs/ComputerUseSettings",
      "default": {
        "enabled": false,
        "foreground": "ask",
        "show_cursor": false
      }
    },
    "antigravity": {
      "description": "Antigravity's link to Kybern's tools. Per machine: it is one entry in this machine's `agy` MCP servers.",
      "$ref": "#/$defs/AntigravitySettings",
      "default": {
        "kybern_tools": true
      }
    },
    "orchestration": {
      "description": "Limits on agents delegating work to other agents.",
      "$ref": "#/$defs/OrchestrationSettings",
      "default": {
        "max_active_children": 4,
        "lead_max_children": 6,
        "max_depth": 2,
        "lead_autonomy": "propose_large",
        "lead_workspace": "shared",
        "lead_push_without_asking": false,
        "rotation_budget_tokens": 200000
      }
    },
    "tell_agents_about_kybern": {
      "description": "Give new agent sessions a short guide to Kybern: images, notes and\ntasks, other threads, helpers. Applies to sessions started after the change.",
      "type": "boolean",
      "default": true
    },
    "ask_deadlines": {
      "description": "Whether an agent's question may carry a default and a wait, and the\nlongest wait it can set (`kybern_ask_user`).",
      "$ref": "#/$defs/AskDeadlineSettings",
      "default": {
        "enabled": true,
        "max_seconds": 900
      }
    },
    "preview_allowed_folders": {
      "description": "Folders outside a project the user allowed the Preview panel to serve\nfiles from. Canonical absolute paths; a grant covers descendants.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "network": {
      "description": "Joining and staying joined to the machine network.",
      "$ref": "#/$defs/NetworkSettings",
      "default": {
        "configured": false,
        "enabled": false,
        "port": 4173,
        "keep_reachable": true
      }
    }
  },
  "$defs": {
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor",
        "antigravity"
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    },
    "ProviderSettings": {
      "description": "Per-provider configuration in settings.json.",
      "type": "object",
      "properties": {
        "accounts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProviderAccount"
          }
        },
        "default_account": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_accounts": {
          "description": "Account overrides keyed by the registered project path.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "binary": {
          "description": "Absolute path to the executable; omit to look it up on PATH.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "Default model for new threads.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "description": "Extra environment variables for the provider process.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "project_profiles": {
          "description": "OMP profiles keyed by the registered project's absolute path. Worktrees\ninherit their project's profile; an empty value selects OMP's default.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ProviderAccount": {
      "description": "A named, native-isolated account. Secrets remain in the harness directory.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        },
        "color": {
          "description": "Palette key: blue | green | purple | pink | teal | amber. Unknown keys render without a dot.",
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "description": "Last identity seen by the daemon, for instant rendering. Never a credential.",
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "directory"
      ]
    },
    "UpdateTrack": {
      "description": "The release line updates come from. Every release reaches Dev first as a\n`vX.Y.Z-dev.N` prerelease; Stable gets a version later, once it has shipped\non Dev. A machine never moves to an older version: after switching from Dev\nto Stable it keeps its dev build until a stable release is newer.",
      "type": "string",
      "enum": [
        "stable",
        "dev"
      ]
    },
    "BackgroundSettings": {
      "description": "Limits on what the daemon keeps alive after work finishes. Agent processes\nare resumed from the provider's own session on the next message, so\nreleasing one loses no conversation. Every value is in minutes; `0` turns\nthat limit off.",
      "type": "object",
      "properties": {
        "session_idle_minutes": {
          "description": "Minutes an idle thread keeps its agent process before the daemon\nreleases it. Threads that are running, awaiting approval, or have\nbackground work are never released.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 10
        },
        "max_idle_sessions": {
          "description": "Most idle agent processes kept warm at once. The least recently used\nare released first, even before their idle time is up.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 4
        },
        "terminal_idle_minutes": {
          "description": "Minutes a shell with no attached client and no foreground job stays\nopen before the daemon closes it.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 60
        },
        "daemon_idle_exit_minutes": {
          "description": "Minutes with no clients, agents, terminals, or queued work before the\ndaemon exits. Only for daemons the desktop app starts on demand: the\nCLI and remote clients do not restart a daemon that has exited.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "save_power_on_battery": {
          "description": "While the host runs on battery, release idle agent processes after\n`BATTERY_SESSION_IDLE` instead of `session_idle_minutes` and hold\nautomatic harness updates until power returns.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "AccessSettings": {
      "description": "Extra listeners the daemon opens besides its loopback port. Persisted so\na restart keeps the daemon reachable for paired phones.",
      "type": "object",
      "properties": {
        "tailscale": {
          "description": "Also listen on this machine's Tailscale address, so devices on the\nsame tailnet can pair and connect directly.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "ComputerUseSettings": {
      "description": "Agents drive apps on this computer through a separately installed\nprogram: CuaDriver or agent-desktop on macOS, agent-desktop on Windows and\nLinux. Codex keeps OpenAI's own computer-use plugin where it has one.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Offer the computer tools to new agent sessions.",
          "type": "boolean",
          "default": false
        },
        "foreground": {
          "description": "Whether an agent may ask to use the real cursor and focus.",
          "$ref": "#/$defs/ComputerForeground",
          "default": "ask"
        },
        "show_cursor": {
          "description": "Draw CuaDriver's agent cursor where agents act. Off by default: the\ncursor overlay in CuaDriver 0.28 can hold over a gigabyte of\nscreen-sized frames.",
          "type": "boolean",
          "default": false
        },
        "always_allowed_apps": {
          "description": "Apps (display names) agents may control in the background without\nasking. Filled by \"Always allow\" on the approval card.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "driver": {
          "description": "The program behind the tools on this machine. Unset means the OS\ndefault: CuaDriver on macOS, agent-desktop on Windows and Linux. A\ndriver this OS lacks falls back to the default.",
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerDriver"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ComputerForeground": {
      "oneOf": [
        {
          "description": "Background by default; foreground after the user approves it per app.",
          "type": "string",
          "const": "ask"
        },
        {
          "description": "Background only.",
          "type": "string",
          "const": "never"
        }
      ]
    },
    "ComputerDriver": {
      "description": "A program that reads and drives apps for the computer tools.",
      "oneOf": [
        {
          "description": "trycua's CuaDriver.app (macOS).",
          "type": "string",
          "const": "cua_driver"
        },
        {
          "description": "vercel-labs' agent-desktop CLI (macOS, Windows, Linux).",
          "type": "string",
          "const": "agent_desktop"
        }
      ]
    },
    "AntigravitySettings": {
      "description": "Antigravity has no per-session MCP configuration, so Kybern keeps one entry,\n`kybern`, in `agy`'s own MCP servers (added and removed with `agy mcp`).",
      "type": "object",
      "properties": {
        "kybern_tools": {
          "description": "Let Antigravity sessions use Kybern's tools through that entry. On by\ndefault: a session adds the entry when it starts, and turning this off\nremoves it.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "OrchestrationSettings": {
      "description": "Limits for `kybern_agent_delegate`. Read each time an agent delegates.",
      "type": "object",
      "properties": {
        "max_active_children": {
          "description": "Most delegated children one thread may have running at once (1..=16).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 4
        },
        "lead_max_children": {
          "description": "The same limit when the delegating thread is a project's Coordinator (1..=16).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 6
        },
        "max_depth": {
          "description": "Deepest chain of delegation: 1 means only top-level threads delegate (1..=4).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 2
        },
        "role_defaults": {
          "description": "The harness, model and effort a Coordinator uses for a kind of work when\nit does not ask for another. Keys: research, implementation, review,\ndesign and test (`general` has no default). Projects override per role.",
          "type": "object",
          "properties": {
            "design": {
              "$ref": "#/$defs/RoleDefault"
            },
            "general": {
              "$ref": "#/$defs/RoleDefault"
            },
            "implementation": {
              "$ref": "#/$defs/RoleDefault"
            },
            "research": {
              "$ref": "#/$defs/RoleDefault"
            },
            "review": {
              "$ref": "#/$defs/RoleDefault"
            },
            "test": {
              "$ref": "#/$defs/RoleDefault"
            }
          },
          "additionalProperties": false
        },
        "lead_autonomy": {
          "description": "How freely the Coordinator acts. Projects can override it.",
          "$ref": "#/$defs/LeadAutonomy",
          "default": "propose_large"
        },
        "lead_workspace": {
          "description": "Where the Coordinator's children work when it does not say.",
          "$ref": "#/$defs/DelegationWorkspace",
          "default": "shared"
        },
        "lead_push_without_asking": {
          "description": "Let the Coordinator push and open pull requests without asking first.\nMerging a pull request always asks.",
          "type": "boolean",
          "default": false
        },
        "rotation_budget_tokens": {
          "description": "Start a fresh Coordinator session, with a handoff, once its context passes\nthis many tokens (at most half the model's window). 0 turns it off;\notherwise at least 50 000. Projects can override it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 200000
        }
      }
    },
    "RoleDefault": {
      "description": "The harness, model and effort used for one kind of delegated work. Every\nfield is optional: an unset one follows the delegating thread.",
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderInstance"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProviderInstance": {
      "description": "A configured account/instance of a provider. `default` is created implicitly.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instance"
      ]
    },
    "LeadAutonomy": {
      "description": "How freely a Coordinator acts before asking the user.",
      "oneOf": [
        {
          "description": "Acts on its own judgment and reports.",
          "type": "string",
          "const": "act"
        },
        {
          "description": "Acts on small work; proposes a plan first for anything large or risky.",
          "type": "string",
          "const": "propose_large"
        },
        {
          "description": "Proposes a plan before every piece of work.",
          "type": "string",
          "const": "propose_first"
        }
      ]
    },
    "DelegationWorkspace": {
      "description": "Where a delegated child works.",
      "oneOf": [
        {
          "description": "The parent's checkout and branch.",
          "type": "string",
          "const": "shared"
        },
        {
          "description": "Its own git worktree on `kybern/<child-id>`, seeded from the parent's\ncurrent uncommitted state.",
          "type": "string",
          "const": "worktree"
        }
      ]
    },
    "AskDeadlineSettings": {
      "description": "Limits for questions that answer themselves after a deadline. Read each\ntime an agent asks. Approvals, passwords, secrets, sign-ins and\npermissions never have a deadline, whatever these say.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Let an agent give a question a default and a wait. Off: the question waits for the user.",
          "type": "boolean",
          "default": true
        },
        "max_seconds": {
          "description": "The longest wait an agent can set, in seconds (60..=14400).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 900
        }
      }
    },
    "NetworkSettings": {
      "description": "The `settings.network` section.",
      "type": "object",
      "properties": {
        "configured": {
          "description": "A user has chosen on or off. Old saved switches are conservatively treated as choices.",
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "description": "\"Connect to your other machines\".",
          "type": "boolean",
          "default": false
        },
        "port": {
          "description": "The fixed port the Tailscale listener binds. When taken, the daemon tries the next six.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 4173
        },
        "keep_reachable": {
          "description": "\"Keep this machine reachable when Kybern is closed\" (ADE-119): while this machine is in a\nnetwork with the network on, its daemon is started at login by a per-user login item, so the\nother members reach it with no app window open. Per machine like the rest of this section: it\nregisters an item with this computer's own login, and a laptop may opt out where a desktop\nopts in.",
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
